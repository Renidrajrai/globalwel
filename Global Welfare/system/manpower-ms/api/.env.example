NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manpower
# Exact browser origins, separated by commas. Keep schemes and ports.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
PASSPORT_HMAC_KEY=replace-with-a-long-random-secret
PASSPORT_ENC_KEY=replace-with-a-32-byte-key
